# ---------------------------------------------------------------------------
#
# One recipe, two images for sealed virtual screening (job_storage_mode=presigned):
#
#   cpu  the CPU image. The AWS Batch docking jobs (job definition vf-jobdef-afvs-sealed) run
#        templates/afvs_run.py from it with no AWS identity, as UID 1000 on a read-only root
#        filesystem, reaching S3 only through presigned URLs; the T2 sealed tool container uses it
#        for receptor prep, result parsing and active learning (bash run.sh in /app, calling
#        $AFVS_HOME/tools/*). This is the last stage, so a build with no --target makes it.
#   gpu  the same image plus Uni-Dock (/opt/unidock, linked as tools/bin/unidock) for the GPU
#        job definition. Nothing else differs: same user, same files, same checks.
#
# It has AFVS (at $AFVS_HOME=/opt/AFVS), the bundled docking binaries, Open
# Babel, and python with pandas/pyarrow plus torch/rdkit, and no AWS SDK on
# purpose: nothing that runs in it should hold or reach for credentials.
# No ENTRYPOINT: the job definition and the pod each set the command. Nothing is fetched at run time.
#
# Build and push both, from a clean checkout, with tools/docker/build_sealed.sh (tags
# sealed-cpu-<7 char AFVS sha> and sealed-gpu-<7 char AFVS sha>). By hand, from the repository root:
#
#   docker build --platform linux/amd64 --target cpu -t afvs-sealed-cpu -f tools/docker/Dockerfile.sealed .
#   docker build --platform linux/amd64 --target gpu -t afvs-sealed-gpu -f tools/docker/Dockerfile.sealed .
#
# The bundled docking binaries in bin/ are x86-64, so the images are amd64.
#
# ---------------------------------------------------------------------------

# The bundled bin/gwovina is linked against Boost 1.65, which bookworm does not
# have: rebuild it against the image's Boost, as tools/docker/Dockerfile does
FROM --platform=linux/amd64 python:3.12.8-slim-bookworm AS gwovina

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential wget ca-certificates \
        libboost-system-dev libboost-thread-dev libboost-program-options-dev libboost-filesystem-dev

WORKDIR /build
RUN wget -q -O gwovina-1.0.tar.gz https://sourceforge.net/projects/gwovina/files/gwovina-1.0.tar.gz/download \
    && echo "2007503d9dd7ce34347f8a9fe6d8d76f97d3aec837c38d783da83cb573abafc5  gwovina-1.0.tar.gz" | sha256sum -c - \
    && tar -xzf gwovina-1.0.tar.gz \
    && cd gwovina-1.0/build/linux/release \
    && make gwovina LIBS="-l boost_system -l boost_thread -l boost_program_options -l boost_filesystem" \
    && mv gwovina /build/gwovina-bin

# Uni-Dock for the gpu image: the packages in tools/docker/unidock.pins, each checked against its
# sha256, unpacked by hand (no conda), keeping the binary and the libraries its RPATH ($ORIGIN/../lib)
# finds. The C++ runtime is conda-forge's because the binary needs CXXABI_1.3.15, which bookworm's
# libstdc++ (GCC 12) lacks.
FROM --platform=$BUILDPLATFORM python:3.12.8-slim-bookworm AS unidock-pkgs

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates unzip zstd \
    && rm -rf /var/lib/apt/lists/*

COPY tools/docker/unidock.pins /pkgs/unidock.pins
WORKDIR /pkgs
RUN set -eu; \
    grep -v '^#' unidock.pins | while read -r file sha; do \
        curl -fsSL --retry 3 -o "$file" "https://conda.anaconda.org/conda-forge/linux-64/$file"; \
        echo "$sha  $file" | sha256sum -c -; \
        mkdir "x-$file"; \
        unzip -q -d "x-$file" "$file"; \
        for part in "x-$file"/*.tar.zst; do zstd -dc "$part" | tar -x -C "x-$file"; done; \
    done; \
    mkdir -p /opt/unidock/bin /opt/unidock/lib; \
    cp x-unidock-*/bin/unidock /opt/unidock/bin/; \
    cp x-unidock-*/info/licenses/LICENSE /opt/unidock/LICENSE; \
    cp -a x-libboost-*/lib/libboost_thread.so.1.88.0 x-libboost-*/lib/libboost_filesystem.so.1.88.0 \
          x-libboost-*/lib/libboost_program_options.so.1.88.0 x-libboost-*/lib/libboost_system.so.1.88.0 /opt/unidock/lib/; \
    cp -a x-libstdcxx-*/lib/libstdc++.so.6 x-libstdcxx-*/lib/libstdc++.so.6.0.36 /opt/unidock/lib/; \
    cp -a x-libgcc-*/lib/libgcc_s.so.1 /opt/unidock/lib/; \
    cp -a x-libgomp-*/lib/libgomp.so.1.0.0 /opt/unidock/lib/ && ln -s libgomp.so.1.0.0 /opt/unidock/lib/libgomp.so.1; \
    echo "ce09fb167733c8df916636395571a0d5a80b36513110a888f57e081234e06e16  /opt/unidock/bin/unidock" | sha256sum -c -

FROM --platform=linux/amd64 python:3.12.8-slim-bookworm AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends openbabel procps \
        libboost-system1.74.0 libboost-thread1.74.0 libboost-program-options1.74.0 libboost-filesystem1.74.0 \
    && rm -rf /var/lib/apt/lists/*

# Verify obabel is available
RUN obabel -V

RUN pip install --no-cache-dir \
        numpy==2.1.3 \
        pandas==2.2.3 \
        pyarrow==18.1.0 \
        scipy==1.14.1 \
        tqdm==4.67.1 \
        jinja2==3.1.4 \
        rdkit==2024.9.6 \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1

ENV AFVS_HOME=/opt/AFVS
ENV AFVS_TOOLS_PATH=/opt/AFVS/tools/bin

# The AFVS tools (scripts, templates, docking binaries, vendored molpal)
COPY tools /opt/AFVS/tools
COPY --from=gwovina /build/gwovina-bin /opt/AFVS/tools/bin/gwovina
RUN chmod +x /opt/AFVS/tools/*.py /opt/AFVS/tools/templates/*.py /opt/AFVS/tools/templates/*.sh /opt/AFVS/tools/bin/* \
    && rm -rf /opt/AFVS/tools/docker

# Fail the build if what run.sh relies on is missing, or if the docking job or
# the active-learning stack cannot import
RUN command -v bash stdbuf tee python3 \
    && ! ldd /opt/AFVS/tools/bin/* 2> /dev/null | grep "not found" \
    && cd /opt/AFVS/tools \
    && python -c "import pandas, pyarrow, torch, rdkit" \
    && python -c "import ast; ast.parse(open('templates/afvs_run.py').read())" \
    && python afvs_al_controller.py --help > /dev/null \
    && ! python -c "import boto3" 2> /dev/null

# Matches the sealed pod's unprivileged tool container. The tools write their
# workflow state beside themselves (templates/all.ctrl, ../workflow,
# ../input-files), so the tree belongs to that user.
RUN useradd --uid 1000 --create-home afvs \
    && mkdir -p /opt/AFVS/workflow /opt/AFVS/input-files /app/inputs /app/out \
    && chown -R 1000:1000 /opt/AFVS /app
USER 1000

WORKDIR /app


# The GPU image: base plus Uni-Dock. The binary has CUDA's runtime linked in; libcuda.so.1 comes from the
# host driver through the NVIDIA container runtime, which needs the compute capability asked for here.
FROM base AS gpu

ARG AFVS_REVISION=unknown
USER root
COPY --from=unidock-pkgs /opt/unidock /opt/unidock
RUN ln -s /opt/unidock/bin/unidock /opt/AFVS/tools/bin/unidock \
    && ! ldd /opt/unidock/bin/unidock | grep "not found" \
    && /opt/unidock/bin/unidock --version 2>&1 | grep -q "Uni-Dock v1.2.0"
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
LABEL org.opencontainers.image.revision="${AFVS_REVISION}" \
      bio.tamarind.afvs.flavor="gpu" \
      bio.tamarind.unidock.version="1.2.0" \
      bio.tamarind.unidock.binary-sha256="ce09fb167733c8df916636395571a0d5a80b36513110a888f57e081234e06e16"
USER 1000


# The CPU image: base as it is. Last, so it is what a build with no --target makes.
FROM base AS cpu

ARG AFVS_REVISION=unknown
LABEL org.opencontainers.image.revision="${AFVS_REVISION}" \
      bio.tamarind.afvs.flavor="cpu"
