# ---------------------------------------------------------------------------
#
# CPU-only image for sealed virtual screening (job_storage_mode=presigned):
#
#  - the AWS Batch docking jobs (job definition vf-jobdef-afvs-sealed) run
#    templates/afvs_run.py from it with no AWS identity, as UID 1000 on a
#    read-only root filesystem, reaching S3 only through presigned URLs;
#  - the T2 sealed tool container uses it for receptor prep, result parsing
#    and active learning (bash run.sh in /app, calling $AFVS_HOME/tools/*).
#
# It has AFVS (at $AFVS_HOME=/opt/AFVS), the bundled docking binaries, Open
# Babel, and python with pandas/pyarrow plus torch/rdkit, and no AWS SDK on
# purpose: nothing that runs in it should hold or reach for credentials.
# No ENTRYPOINT: the job definition and the pod each set the command.
# Build from the repository root:
#
#   docker build --platform linux/amd64 -t afvs-sealed -f tools/docker/Dockerfile.sealed .
#
# The bundled docking binaries in bin/ are x86-64, so the image is amd64.
#
# ---------------------------------------------------------------------------

FROM --platform=linux/amd64 python:3.12.8-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends openbabel procps \
    && rm -rf /var/lib/apt/lists/*

# Verify obabel is available
RUN obabel -V

RUN pip install --no-cache-dir \
        numpy==2.1.3 \
        pandas==2.2.3 \
        pyarrow==18.1.0 \
        scipy==1.14.1 \
        tqdm==4.67.1 \
        jinja2==3.1.4 \
        rdkit==2024.9.6 \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1

ENV AFVS_HOME=/opt/AFVS
ENV AFVS_TOOLS_PATH=/opt/AFVS/tools/bin

# The AFVS tools (scripts, templates, docking binaries, vendored molpal)
COPY tools /opt/AFVS/tools
RUN chmod +x /opt/AFVS/tools/*.py /opt/AFVS/tools/templates/*.py /opt/AFVS/tools/bin/* \
    && rm -rf /opt/AFVS/tools/docker

# Fail the build if what run.sh relies on is missing, or if the docking job or
# the active-learning stack cannot import
RUN command -v bash stdbuf tee python3 \
    && cd /opt/AFVS/tools \
    && python -c "import pandas, pyarrow, torch, rdkit" \
    && python -c "import ast; ast.parse(open('templates/afvs_run.py').read())" \
    && python afvs_al_controller.py --help > /dev/null \
    && ! python -c "import boto3" 2> /dev/null

# Matches the sealed pod's unprivileged tool container. The tools write their
# workflow state beside themselves (templates/all.ctrl, ../workflow,
# ../input-files), so the tree belongs to that user.
RUN useradd --uid 1000 --create-home afvs \
    && mkdir -p /opt/AFVS/workflow /opt/AFVS/input-files /app/inputs /app/out \
    && chown -R 1000:1000 /opt/AFVS /app
USER 1000

WORKDIR /app
